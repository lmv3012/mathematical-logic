        "\n",
        "# Импорт библиотеки NumPy для работы с массивами\n",
        "import numpy as np\n",
        "\n",
        "# Импорт модуля random для генерации случайных чисел\n",
        "import random\n",
        "\n",
        "# Импорт библиотеки Matplotlib для построения графиков\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Фиксация случайного зерна для воспроизводимости результатов\n",
        "random.seed(42)\n",
        "np.random.seed(42)\n",
        "\n",
        "# Количество дискретных уровней очереди\n",
        "buckets = 5\n",
        "\n",
        "# Функция дискретизации длины очереди\n",
        "def disc(queue):\n",
        "\n",
        "    # Очередь от 0 до 15 переводится в уровень от 0 до 4\n",
        "    return min(buckets - 1, queue // 3)\n",
        "\n",
        "# Функция, моделирующая один такт работы перекрёстка\n",
        "def env_step(qn, qe, phase, action):\n",
        "\n",
        "    # Если агент решил переключить светофор\n",
        "    if action == 1:\n",
        "\n",
        "        # Фаза меняется на противоположную\n",
        "        phase = 1 - phase\n",
        "\n",
        "        # В такт переключения автомобили не проезжают\n",
        "        passed = 0\n",
        "\n",
        "    # Если агент решил сохранить текущую фазу\n",
        "    else:\n",
        "\n",
        "        # Если зелёный свет горит для направления Север–Юг\n",
        "        if phase == 0:\n",
        "\n",
        "            # Случайно определяется число проехавших автомобилей\n",
        "            passed = min(qn, random.choices(\n",
        "                [0, 1, 2, 3],\n",
        "                [0.1, 0.3, 0.4, 0.2]\n",
        "            )[0])\n",
        "\n",
        "            # Уменьшение очереди на направлении NS\n",
        "            qn -= passed\n",
        "\n",
        "        # Если зелёный свет горит для направления Восток–Запад\n",
        "        else:\n",
        "\n",
        "            # Случайно определяется число проехавших автомобилей\n",
        "            passed = min(qe, random.choices(\n",
        "                [0, 1, 2, 3],\n",
        "                [0.1, 0.3, 0.4, 0.2]\n",
        "            )[0])\n",
        "\n",
        "            # Уменьшение очереди на направлении EW\n",
        "            qe -= passed\n",
        "\n",
        "    # Прибытие новых автомобилей на направление NS\n",
        "    qn = min(15, qn + random.choice([0, 1, 1, 2]))\n",
        "\n",
        "    # Прибытие новых автомобилей на направление EW\n",
        "    qe = min(15, qe + random.choice([0, 1, 1, 2]))\n",
        "\n",
        "    # Награда равна минус суммарной длине очередей\n",
        "    reward = -(qn + qe)\n",
        "\n",
        "    # Если фаза была переключена, назначается дополнительный штраф\n",
        "    if action == 1:\n",
        "        reward -= 5\n",
        "\n",
        "    # Возврат нового состояния среды и награды\n",
        "    return qn, qe, phase, reward\n",
        "\n",
        "# Создание Q-таблицы:\n",
        "# очередь NS, очередь EW, фаза светофора, действие\n",
        "Q = np.zeros((buckets, buckets, 2, 2))\n",
        "\n",
        "# Скорость обучения\n",
        "alpha = 0.2\n",
        "\n",
        "# Коэффициент дисконтирования\n",
        "gamma = 0.95\n",
        "\n",
        "# Количество эпизодов обучения\n",
        "episodes = 2000\n",
        "\n",
        "# Количество тактов управления в одном эпизоде\n",
        "steps = 100\n",
        "\n",
        "# Список для хранения средней награды каждого эпизода\n",
        "rewards = []\n",
        "\n",
        "# Начальная вероятность случайного действия\n",
        "epsilon = 1.0\n",
        "\n",
        "# Цикл по всем эпизодам обучения\n",
        "for episode in range(episodes):\n",
        "\n",
        "    # Случайная начальная очередь на направлении NS\n",
        "    qn = random.randint(0, 4)\n",
        "\n",
        "    # Случайная начальная очередь на направлении EW\n",
        "    qe = random.randint(0, 4)\n",
        "\n",
        "    # Случайная начальная фаза светофора\n",
        "    phase = random.randint(0, 1)\n",
        "\n",
        "    # Постепенное уменьшение вероятности случайного действия\n",
        "    epsilon = max(0.05, epsilon * 0.995)\n",
        "\n",
        "    # Обнуление суммарной награды эпизода\n",
        "    total_reward = 0\n",
        "\n",
        "    # Цикл по тактам внутри эпизода\n",
        "    for t in range(steps):\n",
        "\n",
        "        # Формирование дискретного состояния среды\n",
        "        state = (disc(qn), disc(qe), phase)\n",
        "\n",
        "        # С вероятностью epsilon выбирается случайное действие\n",
        "        if random.random() < epsilon:\n",
        "            action = random.randrange(2)\n",
        "\n",
        "        # Иначе выбирается действие с максимальным Q-значением\n",
        "        else:\n",
        "            action = int(np.argmax(Q[state]))\n",
        "\n",
        "        # Выполнение действия и получение новой ситуации на перекрёстке\n",
        "        qn, qe, phase, reward = env_step(qn, qe, phase, action)\n",
        "\n",
        "        # Формирование нового дискретного состояния\n",
        "        next_state = (disc(qn), disc(qe), phase)\n",
        "\n",
        "        # Обновление Q-значения по формуле Q-learning\n",
        "        Q[state][action] += alpha * (\n",
        "            reward + gamma * np.max(Q[next_state]) - Q[state][action]\n",
        "        )\n",
        "\n",
        "        # Накопление награды эпизода\n",
        "        total_reward += reward\n",
        "\n",
        "    # Сохранение средней награды за эпизод\n",
        "    rewards.append(total_reward / steps)\n",
        "\n",
        "    # Сохранение средней награды за один такт текущего эпизода\n",
        "    rewards.append(total_reward / steps)\n",
        "\n",
        "    # Вывод результатов после каждых 200 эпизодов\n",
        "    if (episode + 1) % 200 == 0:\n",
        "\n",
        "        # Среднее значение по последним 100 эпизодам\n",
        "        mean_reward = np.mean(rewards[-100:])\n",
        "\n",
        "        # Вывод номера эпизода, средней награды и текущего epsilon\n",
        "        print(\n",
        "            f\"Эпизод {episode + 1:<4} | \"\n",
        "            f\"средняя награда за 100 эп.: {mean_reward:.2f} | \"\n",
        "            f\"ε = {epsilon:.3f}\"\n",
        "        )\n",
        "\n",
        "\n",
        "# Задание размера окна для скользящего среднего\n",
        "window = 100\n",
        "\n",
        "# Вычисление скользящего среднего награды\n",
        "avg_rewards = [\n",
        "    np.mean(rewards[max(0, i - window + 1): i + 1])\n",
        "    for i in range(len(rewards))\n",
        "]\n",
        "\n",
        "# Создание окна графика\n",
        "plt.figure(figsize=(8, 4))\n",
        "\n",
        "# Построение награды за каждый эпизод\n",
        "plt.plot(rewards, color=\"lightgray\", linewidth=0.7)\n",
        "\n",
        "# Построение скользящего среднего за 100 эпизодов\n",
        "plt.plot(avg_rewards, color=\"red\", linewidth=2)\n",
        "\n",
        "# Подпись оси X\n",
        "plt.xlabel(\"Эпизод\")\n",
        "\n",
        "# Подпись оси Y\n",
        "plt.ylabel(\"Награда\")\n",
        "\n",
        "# Заголовок графика\n",
        "plt.title(\"Кривая обучения Q-learning\")\n",
        "\n",
        "# Добавление сетки\n",
        "plt.grid(alpha=0.3)\n",
        "\n",
        "# Автоматическое выравнивание графика\n",
        "plt.tight_layout()\n",
        "\n",
        "# Сохранение графика в файл\n",
        "plt.savefig(\"traffic_learning_curve.png\", dpi=150)\n",
        "\n",
        "# Отображение графика\n",
        "plt.show()\n",
        "\n",
        "# Названия действий для вывода политики\n",
        "action_names = [\"K\", \"S\"]\n",
        "\n",
        "# Вывод выученной политики для каждой фазы светофора\n",
        "for phase in range(2):\n",
        "\n",
        "    # Заголовок текущей фазы\n",
        "    print(f\"Текущая фаза: {phase}\")\n",
        "\n",
        "    # Цикл по уровням очереди NS\n",
        "    for i in range(buckets):\n",
        "\n",
        "        # Формирование строки политики для текущего уровня очереди NS\n",
        "        row = []\n",
        "\n",
        "        # Цикл по уровням очереди EW\n",
        "        for j in range(buckets):\n",
        "\n",
        "            # Выбор действия с максимальным Q-значением\n",
        "            best_action = int(np.argmax(Q[i, j, phase]))\n",
        "\n",
        "            # Добавление обозначения действия\n",
        "            row.append(action_names[best_action])\n",
        "\n",
        "        # Вывод строки политики\n",
        "        print(\" \".join(row))"
      ]
